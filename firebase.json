{
  "hosting": {
    "public": "deploy",
    "ignore": ["**/.*", "**/node_modules/**", "**/*.zip"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "asia-northeast3",
    "rules": "firebase/firestore.rules"
  }
}
