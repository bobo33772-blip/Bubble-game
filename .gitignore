# build outputs (node build.js makes them; CI builds its own)
dist/
deploy/
release/
# old copies from before v4 (git history keeps everything now)
src-v3-backup/
tools-v3-backup/
# local tools / caches
node_modules/
firebase/.firebase/
*.log
.DS_Store
Thumbs.db
# Firebase CLI
.firebase/
firebase-debug.log*
firebase-debug.*.log*

# relay servers for online play (CI writes it from the TURN_CONFIG secret)
turn.config.json
# the relay Worker (cloudflare/, CLOUDFLARE-SETUP.md): wrangler's local state, its npm install, a local vars file (none is needed)
cloudflare/.wrangler/
cloudflare/node_modules/
cloudflare/.dev.vars
# a local convenience: the relay Worker's address for build.js (CI uses the repository variable RELAY_URL)
relay.config.json
